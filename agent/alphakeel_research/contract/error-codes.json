    "data.funding_missing": {"class": "data_insufficient", "http": 422, "retryable": false},
    "data.fx_missing": {"class": "data_insufficient", "http": 422, "retryable": false},
    "data.quote_missing": {"class": "data_insufficient", "http": 422, "retryable": false},
    "data.pack_not_ready": {"class": "data_insufficient", "http": 409, "retryable": true},
    "data.pack_expired": {"class": "data_insufficient", "http": 410, "retryable": false},
    "data.future_read": {"class": "request_invalid", "http": 422, "retryable": false},
