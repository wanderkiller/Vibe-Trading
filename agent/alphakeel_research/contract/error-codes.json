{
  "contract": "alphakeel.research",
  "major": 1,
  "classes": {
    "request_invalid": "The request is malformed or breaks a rule; fix it, retrying unchanged cannot succeed.",
    "unauthorized": "Missing, wrong, expired or revoked service credential, or the scope does not allow this call.",
    "not_found": "The identity does not exist for this caller (other callers' objects look the same).",
    "conflict": "The same idempotency key was reused with different content, or the state does not allow the call.",
    "capability_unsupported": "The request is valid but outside what the engine models; nothing was run.",
    "data_insufficient": "The frozen data cannot answer the request (coverage, missing quotes/FX/settlements, expired objects).",
    "profile_mismatch": "The execution profiles of the two sides are not the same, so the results are not comparable.",
    "evidence_corrupt": "An uploaded or stored artifact fails size, schema, hash or reference checks.",
    "resource_exhausted": "A bound was hit (queue, size, rows, disk, concurrency); retry later or narrow the request.",
    "engine_failure": "The engine or the service failed internally; the job is failed or interrupted, never silently retried."
  },
  "codes": {
    "request.invalid": {"class": "request_invalid", "http": 422, "retryable": false},
    "request.bad_json": {"class": "request_invalid", "http": 400, "retryable": false},
    "request.bad_query": {"class": "request_invalid", "http": 400, "retryable": false},
    "request.bad_key": {"class": "request_invalid", "http": 422, "retryable": false},
    "request.too_large": {"class": "resource_exhausted", "http": 413, "retryable": false},
    "schema.type": {"class": "request_invalid", "http": 422, "retryable": false},
    "schema.required": {"class": "request_invalid", "http": 422, "retryable": false},
    "schema.enum": {"class": "request_invalid", "http": 422, "retryable": false},
    "schema.const": {"class": "request_invalid", "http": 422, "retryable": false},
    "schema.format": {"class": "request_invalid", "http": 422, "retryable": false},
    "schema.length": {"class": "request_invalid", "http": 422, "retryable": false},
    "schema.range": {"class": "request_invalid", "http": 422, "retryable": false},
    "schema.additional": {"class": "request_invalid", "http": 422, "retryable": false},
    "schema.union": {"class": "request_invalid", "http": 422, "retryable": false},
    "schema.float": {"class": "request_invalid", "http": 422, "retryable": false},
    "schema.ref": {"class": "engine_failure", "http": 500, "retryable": false},
