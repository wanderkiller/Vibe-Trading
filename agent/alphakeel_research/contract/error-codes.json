    "data.cursor_invalid": {"class": "request_invalid", "http": 422, "retryable": false},
    "intent.non_finite": {"class": "request_invalid", "http": 422, "retryable": false},
    "intent.non_positive_qty": {"class": "request_invalid", "http": 422, "retryable": false},
    "intent.overflow": {"class": "request_invalid", "http": 422, "retryable": false},
    "intent.out_of_window": {"class": "request_invalid", "http": 422, "retryable": false},
    "intent.stale_decision": {"class": "request_invalid", "http": 422, "retryable": false},
    "intent.not_a_decision_time": {"class": "request_invalid", "http": 422, "retryable": false},
    "intent.duplicate": {"class": "request_invalid", "http": 422, "retryable": false},
    "intent.out_of_order": {"class": "request_invalid", "http": 422, "retryable": false},
    "intent.unknown_instrument": {"class": "request_invalid", "http": 422, "retryable": false},
    "intent.reduce_only_needs_position": {"class": "request_invalid", "http": 422, "retryable": false},
    "intent.limit_price_required": {"class": "request_invalid", "http": 422, "retryable": false},
    "intent.too_many": {"class": "resource_exhausted", "http": 413, "retryable": false},
    "profile.mismatch": {"class": "profile_mismatch", "http": 422, "retryable": false},
    "evidence.hash_mismatch": {"class": "evidence_corrupt", "http": 422, "retryable": false},
    "evidence.size": {"class": "evidence_corrupt", "http": 413, "retryable": false},
    "evidence.schema": {"class": "evidence_corrupt", "http": 422, "retryable": false},
    "evidence.reference": {"class": "evidence_corrupt", "http": 422, "retryable": false},
    "evidence.missing_events": {"class": "data_insufficient", "http": 422, "retryable": false},
    "evidence.input_digest": {"class": "evidence_corrupt", "http": 422, "retryable": false},
    "evidence.ledger": {"class": "evidence_corrupt", "http": 422, "retryable": false},
    "evidence.path": {"class": "evidence_corrupt", "http": 422, "retryable": false},
    "resource.queue_full": {"class": "resource_exhausted", "http": 429, "retryable": true},
    "resource.rows": {"class": "resource_exhausted", "http": 413, "retryable": false},
    "resource.disk": {"class": "resource_exhausted", "http": 507, "retryable": true},
    "resource.concurrency": {"class": "resource_exhausted", "http": 429, "retryable": true},
    "resource.frames": {"class": "resource_exhausted", "http": 413, "retryable": false},
    "policy.step_conflict": {"class": "conflict", "http": 409, "retryable": false},
    "policy.step_skipped": {"class": "conflict", "http": 409, "retryable": false},
    "policy.step_late": {"class": "conflict", "http": 409, "retryable": false},
    "policy.identity": {"class": "conflict", "http": 409, "retryable": false},
    "policy.not_waiting": {"class": "conflict", "http": 409, "retryable": true},
    "policy.timeout": {"class": "engine_failure", "http": 409, "retryable": false},
    "run.interrupted": {"class": "engine_failure", "http": 409, "retryable": false},
    "run.cancelled": {"class": "conflict", "http": 409, "retryable": false},
    "engine.failure": {"class": "engine_failure", "http": 500, "retryable": false},
    "service.unavailable": {"class": "engine_failure", "http": 503, "retryable": true}
  }
}
