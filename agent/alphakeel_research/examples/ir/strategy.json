  "sizing": {"notional_per_leg": "100", "max_open": 1, "leverage": null},
  "parameters": {
    "min_net": {"value": "0.001", "robust": ["0.0005", "0.002"], "path": "entry.conditions[0].value"},
    "max_hold_hours": {"value": "1", "robust": ["1", "2"], "path": "exit.max_hold_hours"}
  },
  "provenance": {"tool": "vibe-trading", "run_id": "example", "note": "placeholder provenance for the fixture pack example",
                 "window": {"start": "fixture", "end": "fixture"}}
}
